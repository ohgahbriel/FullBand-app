{
  "name": "fullband-desktop",
  "version": "0.4.4",
  "private": true,
  "description": "FullBand desktop app — self-contained: bundles the Python engine, ffmpeg and the UI.",
  "author": "ohgahbriel",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ohgahbriel.fullband",
    "productName": "FullBand",
    "electronDist": "node_modules/electron/dist",
    "icon": "build/icon.ico",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "loading.html", "package.json"],
    "extraResources": [
      { "from": "_bundle/python", "to": "pyruntime" },
      { "from": "_bundle/ffmpeg", "to": "ffmpeg" },
      { "from": "build/vc_redist.x64.exe", "to": "vc_redist.x64.exe" },
      { "from": "../web/dist", "to": "web" },
      {
        "from": "../server",
        "to": "server",
        "filter": ["**/*", "!.venv", "!.venv/**", "!data", "!data/**", "!**/__pycache__/**", "!**/*.pyc"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "artifactName": "FullBand Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FullBand",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    }
  }
}
